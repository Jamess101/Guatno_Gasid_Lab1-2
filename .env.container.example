DB_PASSWORD=CHANGE_ME
MYSQL_DATABASE=laravel_request_system_db
MYSQL_USER=laravel_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT