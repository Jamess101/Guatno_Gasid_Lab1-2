APP_NAME="Request System"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:8080
LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_system_db
